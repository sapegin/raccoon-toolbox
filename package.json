{
  "name": "raccoon-toolbox",
  "version": "0.1.0",
  "private": true,
  "bugs": {
    "url": "https://github.com/sapegin/raccoon-toolbox/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapegin/raccoon-toolbox.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "npm run tauri dev",
    "build": "tsc && vite build && vite build --ssr && node --experimental-strip-types scripts/prerender.ts",
    "build:app": "npm run tauri build -- --bundles app",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --fix && cargo check --manifest-path src-tauri/Cargo.toml",
    "format": "oxfmt && prettier --write --no-error-on-unmatched-pattern \"**/*.astro\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "npm run lint",
    "posttest": "npm run format",
    "prepare": "husky",
    "generate:unicode": "node --experimental-strip-types scripts/generate-unicode-data.ts",
    "generate:tools": "node --experimental-strip-types scripts/generate-tools.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/language": "6.11.3",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "6.5.2",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@types/diff": "7.0.2",
    "clsx": "2.1.1",
    "colord": "2.9.3",
    "diff": "8.0.2",
    "js-md5": "0.8.3",
    "markdown-to-jsx": "9.7.16",
    "nano-staged": "0.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.9.6",
    "tamia": "^8.0.0",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.72.0",
    "@prettier/plugin-xml": "3.4.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@unicode/unicode-17.0.0": "1.6.14",
    "@vitejs/plugin-react": "^5.1.1",
    "husky": "^9.1.7",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "oxlint-config-raccoon": "10.5.0",
    "oxlint-tailwindcss": "1.3.4",
    "oxlint-tsgolint": "0.24.0",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "nano-staged": {
    "*.{js,cjs,mjs,ts,tsx,css,json,md}": "oxfmt",
    "*.astro": "prettier --write",
    "*.{js,cjs,mjs,ts,tsx,astro}": "oxlint --fix",
    "*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  }
}

{
  "name": "raccoon-toolbox",
  "version": "0.1.0",
  "private": true,
  "bugs": {
    "url": "https://github.com/sapegin/raccoon-toolbox/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapegin/raccoon-toolbox.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "npm run tauri dev",
    "build": "tsc && vite build && vite build --ssr && node --experimental-strip-types scripts/prerender.ts",
    "build:app": "npm run tauri build -- --bundles app",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint && cargo check --manifest-path src-tauri/Cargo.toml",
    "lint:fix": "oxlint --fix && oxfmt && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "npm run lint && oxfmt --check",
    "prepare": "husky",
    "generate:unicode": "node --experimental-strip-types scripts/generate-unicode-data.ts",
    "generate:tools": "node --experimental-strip-types scripts/generate-tools.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@types/diff": "7.0.2",
    "clsx": "2.1.1",
    "colord": "2.10.0",
    "diff": "8.0.2",
    "js-md5": "0.9.2",
    "markdown-to-jsx": "9.10.3",
    "nano-staged": "1.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.4",
    "tamia": "^8.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@prettier/plugin-xml": "3.4.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@unicode/unicode-17.0.0": "1.6.14",
    "@vitejs/plugin-react": "^5.1.1",
    "husky": "^9.1.7",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-config-raccoon": "10.10.0",
    "oxlint-tailwindcss": "1.16.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.9",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "nano-staged": {
    "*.{js,cjs,mjs,ts,tsx,css,json,md}": "oxfmt",
    "*.{js,cjs,mjs,ts,tsx}": "oxlint --fix",
    "*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  },
  "allowScripts": {
    "esbuild": true
  }
}
